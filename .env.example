# Copy this file to .env and replace every REQUIRED value before first start.
# Never commit .env. Generate random values, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Project / UI ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=de-metadata-framework
FLASK_SECRET_KEY=REQUIRED_GENERATE_A_RANDOM_SECRET
ROOT_EMAIL=root@localhost
# Minimum 12 chars with uppercase, lowercase, digit, and special character.
ROOT_PASSWORD=REQUIRED_CHOOSE_A_STRONG_PASSWORD
SCHEDULER_TIMEZONE=Asia/Kolkata
BEHIND_HTTPS_PROXY=0

# Local UI database. AUTH_DATABASE_URL takes precedence when set.
AUTH_DB_HOST=postgres-app
AUTH_DB_PORT=5432
AUTH_DB_NAME=de_app
AUTH_DB_USER=de_app
AUTH_DB_PASSWORD=REQUIRED_CHOOSE_A_DATABASE_PASSWORD
AUTH_DB_SSLMODE=disable
AUTH_DATABASE_URL=

# Bundled MinIO / S3-compatible storage --------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REQUIRED_CHANGE_THE_MINIO_PASSWORD
MINIO_BUCKET=de-data-lake
MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

SOURCE_S3_ENDPOINT=http://minio:9000
# Leave blank to inherit MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
SOURCE_S3_ACCESS_KEY=
SOURCE_S3_SECRET_KEY=
SOURCE_S3_BUCKET=de-source-data-bucket
SOURCE_S3_REGION=us-east-1

METADATA_S3_BUCKET=de-metadata-bucket
# Set per command with --metadata-key, or set a shared default here.
METADATA_S3_KEY=

# Spark / Iceberg ------------------------------------------------------------
SPARK_APP_NAME=DE-Metadata-Framework
SPARK_MASTER=local[*]
ICEBERG_WAREHOUSE=s3a://de-iceberg-warehouse-bucket/
ICEBERG_DATA_BUCKET=de-data-lake
ICEBERG_METADATA_BUCKET=de-iceberg-warehouse-bucket
ICEBERG_CATALOG=minio
ICEBERG_DATABASE=default
LAKE_DATABASE=de_lake
BRONZE_DATABASE=de_bronze
BRONZE_DATA_BUCKET=de-data-bronze
TRANSFORMATION_DATABASE=de_transformation
TRANSFORMATION_DATA_BUCKET=de-data-transformation
SILVER_DATABASE=de_silver
SILVER_DATA_BUCKET=de-data-silver
GOLD_DATABASE=de_gold
GOLD_DATA_BUCKET=de-data-gold
LOG_S3_BUCKET=de-data-migration-logs

# Local Vault. The bundled auto-unseal arrangement is for local development;
# use an externally managed Vault/KMS design for production.
VAULT_API_ADDR=http://localhost:8200
VAULT_PATH=encryption/pii
VAULT_NAMESPACE=
SALT_KEY=REQUIRED_GENERATE_A_RANDOM_SALT
SALT_2=REQUIRED_GENERATE_A_SECOND_RANDOM_SALT

# Optional PostgreSQL/Supabase ingestion source ------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JDBC_URL=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
# Only used by vault-init to create the encrypted database-password artifact.
SUPABASE_DB_PASSWORD_PLAIN=

# DhanHQ / NSE ----------------------------------------------------------------
# Market-data calls need DHAN_CLIENT_ID plus a 24-hour access token. API key
# and secret are only for the interactive consent flow. Never paste credentials
# into source code or command-line arguments.
# The homepage checks configuration locally and exposes no credential values.
# After editing these values, recreate the UI (restart alone does not reload
# Compose environment): docker compose up -d --no-deps --force-recreate ui
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_REDIRECT_URL=
# Headless renewal uses the six-digit account PIN and the Base32 TOTP *seed*;
# DHAN_TOTP_SECRET is not the temporary six-digit authenticator code.
DHAN_PIN=
DHAN_TOTP_SECRET=
# Choose ONE selection source: CSV file, inline symbols, or explicit IDs.
# CSV option: edit repository symbols.csv (symbol header, one symbol per row),
# set DHAN_SYMBOLS_FILE=/app/config/symbols.csv, and leave the other two blank.
# Compose mounts that host file read-only for UI, snapshot runner, and live feed.
DHAN_SYMBOLS_FILE=
# Inline option: exact NSE cash symbols; resolved from Dhan's public master.
# Examples: RELIANCE,TCS,M&M or IDX_I:NIFTY 50 (explicit index prefix).
# You can also enter symbols on the homepage without changing this file.
DHAN_SYMBOLS=
# Advanced option: explicit SEGMENT:SECURITY_ID entries. Leave blank when using
# DHAN_SYMBOLS or DHAN_SYMBOLS_FILE; conflicting sources are rejected.
DHAN_INSTRUMENTS=
DHAN_SNAPSHOT_MODE=quote
DHAN_HTTP_TIMEOUT_SECONDS=15
DHAN_RAW_BUCKET=de-source-data-bucket
DHAN_RAW_PREFIX=dhan/nse
DHAN_FEED_MODE=quote
DHAN_FLUSH_SECONDS=5
DHAN_BATCH_SIZE=1000
# Compose fixes the token file at /run/secrets/dhan-access-token.json and the
# durable collector spool at /var/lib/dhan-spool so their named volumes cannot
# be accidentally bypassed.

# Optional notifications / AI helper ----------------------------------------
BREVO_API_KEY=
BREVO_FROM_EMAIL=
NOTIFY_EMAIL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Optional public profile: docker compose --profile public up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
